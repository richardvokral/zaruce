# ---------------------------------------------------------------------------
# Public — exposed to the browser. Safe to commit defaults; override in Vercel.
# ---------------------------------------------------------------------------

# Where /face/<id> images are served from. Either Modal directly or a CDN
# alias in front of Modal. Same-origin (empty) means use /api/face/<id>.
PUBLIC_FACE_BASE=

# Where the API lives. Same-origin (empty) means use /api/* on this Astro app.
PUBLIC_API_BASE=

# ---------------------------------------------------------------------------
# Secret — server-only. Set these in the Vercel dashboard.
# ---------------------------------------------------------------------------

# Neon pooled connection string (use the one ending in -pooler.region.aws.neon.tech)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Upstash Redis REST API for rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Visitor hashing (HMAC key for ip|ua → opaque visitor_hash). 32+ random bytes.
VISITOR_HASH_KEY=

# Seed salt — must match the Modal `SEED_SALT` secret. Rotating regenerates
# every face; existing slot indices stay valid.
SEED_SALT=

# Modal face endpoint URL (returned by `modal deploy`)
MODAL_FACE_BASE=

# Bearer token for /api/admin/* and the Modal /admin/* routes
ADMIN_TOKEN=

# Tunables
RATE_LIMIT_WINDOW_SEC=600
RATE_LIMIT_MAX=1
DAILY_LIMIT=10
ATTRIBUTE_RETENTION_DAYS=90
